{
  "name": "docsify-isf",
  "version": "1.28.0",
  "description": "Docsify plugin that turns Markdown links to ISF shader files into interactive WebGL viewers with parameter controls and a live GLSL editor.",
  "main": "docsify-isf.js",
  "files": [
    "docsify-isf.js",
    "README.md",
    "LICENSE",
    "vendor/pupitre-ui/"
  ],
  "scripts": {
    "build": "node tools/build.mjs",
    "build:check": "node tools/build.mjs --check",
    "test": "node tests/run.js && node tests/pui-params.test.js",
    "test:corpus": "node tests/run.js --corpus",
    "test:smoke": "node tests/browser-smoke.mjs",
    "test:coverage": "node tests/es3-coverage.mjs",
    "test:vendor": "node tools/sync-pupitre-ui.mjs --check",
    "serve": "docsify serve .",
    "frame": "node tools/render-frame.mjs",
    "test:frame": "node tests/frame-tool.mjs",
    "sync:pupitre": "node tools/sync-pupitre-ui.mjs"
  },
  "keywords": [
    "docsify",
    "docsify-plugin",
    "isf",
    "shader",
    "webgl",
    "glsl"
  ],
  "license": "MIT",
  "devDependencies": {
    "esprima": "^4.0.1",
    "puppeteer-core": "^24.0.0"
  }
}
